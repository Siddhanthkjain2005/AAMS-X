{
  "name": "aamsx-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AAMS-X operator console: live spectrum waterfall, belief map, decision inspector and the experiment labs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" && tsc -b"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "framer-motion": "13.1.1",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
