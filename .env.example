# AAMS-X configuration.
#
# Copy to `.env` and edit. Every value below is a default that already works —
# the full demo runs from the offline cache with none of these set, and no
# credential is ever required. Nothing here is a secret in the shipped setup;
# keep it that way, and never commit a real `.env`.
#
# All settings use the AAMSX_ prefix (see aamsx/config.py).

# ---- paths -------------------------------------------------------------------
# Cache, window index and registry live under data_dir.
AAMSX_DATA_DIR=./data
AAMSX_REPORTS_DIR=./reports/out

# ---- ingestion ---------------------------------------------------------------
AAMSX_CALLISTO_ARCHIVE=http://soleil.i4ds.ch/solarradio/data/2002-20yy_Callisto
AAMSX_HTTP_TIMEOUT_SEC=45
AAMSX_FETCH_CONCURRENCY=8

# Set false to hard-disable every outbound request: ingestion refuses to touch
# the network and only the offline Parquet cache is served. Useful for an
# air-gapped demo, and for proving no data is fetched mid-presentation.
AAMSX_ALLOW_NETWORK=true

# ---- optional ElectroSense credentials (never required) ----------------------
# The e-CALLISTO archive needs no credentials, and the ElectroSense API no longer
# resolves. Left here because the adapter is implemented: if the service returns,
# fill these in via `.env` only. They are never logged and never sent to the
# browser.
# AAMSX_ELECTROSENSE_API=https://electrosense.org/api
# AAMSX_ELECTROSENSE_USER=
# AAMSX_ELECTROSENSE_PASSWORD=

# ---- measurement -> occupancy conversion -------------------------------------
# Changing any of these changes the derived labels, and therefore every metric.
# They are recorded in each recording's manifest so a reader can tell what was
# used. Re-run scripts/build_index.py after editing.
AAMSX_DB_PER_DIGIT=0.25            # e-CALLISTO nominal scale
AAMSX_OCCUPANCY_THRESHOLD_DB=1.5   # absolute floor for the occupancy decision
AAMSX_OCCUPANCY_K_MAD=5.0          # per-channel significance multiplier
AAMSX_BASELINE_PERCENTILE=10.0     # quiet-time baseline quantile

# ---- experiment engine -------------------------------------------------------
AAMSX_MAX_CONCURRENT_EXPERIMENTS=4
AAMSX_EVENT_QUEUE_SIZE=4096
AAMSX_BATCH_WORKERS=0              # 0 -> os.cpu_count() - 1

# Optional torch extras. Install with: pip install -e ".[neural]"
AAMSX_ENABLE_NEURAL=false          # neural temporal encoder
AAMSX_ENABLE_DEEP_RL=false         # DQN policy (not part of the reported results)

# ---- api ---------------------------------------------------------------------
AAMSX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AAMSX_MAX_UPLOAD_BYTES=268435456   # 256 MiB cap on SigMF imports

# ---- frontend (Vite; only VITE_* reaches the browser) ------------------------
# Never put a secret in a VITE_ variable — everything prefixed VITE_ is compiled
# into the client bundle and is public.
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
